# Copy this file to .env.local and fill only local secrets there.
# .env.local is ignored by git.

DIREXIO_AI_GATEWAY_TOKENS=dxai_test
DIREXIO_AI_TOKEN=dxai_test

# Use echo for no-cost local testing. Use openai-compatible for DeepSeek/OpenAI-compatible providers.
DIREXIO_AI_GATEWAY_MODEL_MODE=openai-compatible
DIREXIO_MODEL_BASE_URL=https://api.deepseek.com
DIREXIO_MODEL_NAME=deepseek-v4-flash
DIREXIO_MODEL_API_KEY=

# Local diagnostics only. Leave unset or 0 for normal use.
DIREXIO_AI_GATEWAY_DEBUG_PROVIDER=0
