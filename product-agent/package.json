{
  "name": "@direxio/product-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx ../tests/product_agent_contract_test.ts",
    "token:generate": "node scripts/generate-token.mjs",
    "start:agent-service": "node dist/bin/agent-service.js",
    "start:ai-gateway": "node dist/bin/ai-gateway.js",
    "dev:agent-service": "tsx src/bin/agent-service.ts",
    "dev:ai-gateway": "tsx src/bin/ai-gateway.ts",
    "dev:integration": "tsx src/bin/dev-integration-server.ts",
    "dev:local:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:stop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-dev.ps1"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "fastify": "^5.9.0",
    "langchain": "^1.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
